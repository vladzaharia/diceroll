.godot/
*.import.tmp
/build/
/export/
.DS_Store
.claude/

# ~/.gitignore has "Icon" (macOS Icon\r files); case-insensitive FS makes it match icon/ dirs
!assets/icon/
!assets/icon/**
!tools/icon/
!tools/icon/**

# Third-party assets are never committed (EXTRA KayKit packs are not redistributable).
# Canonical store: third_party/ ; runtime copies populated by tools/import_assets.sh.
/third_party/
/assets/kaykit/
/assets/audio/
/assets/fonts/

# CI / release outputs
/android/
/.ci-cache/
/build_info.json
*.age.part

# Throwaway test keys for the updater tests (~/.gitignore ignores *.pem)
!tests/fixtures/update/*.pem
