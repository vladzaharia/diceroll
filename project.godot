; Engine configuration file.
config_version=5

[application]

config/name="Diceroll"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.1, 0.06, 0.06, 1)
boot_splash/show_image=false
config/icon="res://assets/icon/icon_macos.png"

[autoload]

Shot="*res://tools/shot.gd"
Audio="*res://game/audio/audio_bus.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
